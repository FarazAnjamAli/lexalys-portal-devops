# Copy to .env for local runs and on EC2. On Elastic Beanstalk, set these as
# "Environment properties" in the console instead (never upload a .env).

NODE_ENV=production
PORT=3000
# Shown in the footer so screenshots prove which deployment you are on
DEPLOY_LABEL=AWS EC2 (IaaS)

# --- Database (EC2: 127.0.0.1; Beanstalk: your RDS endpoint) --------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lexalys_app
DB_PASSWORD=change-me
DB_NAME=lexalys_portal
# Set to "rds" to connect to Amazon RDS over TLS (recommended on Part II)
DB_SSL=

# --- Sessions ---------------------------------------------------------------
# Any long random string. Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Only set true once the site is served over HTTPS
COOKIE_SECURE=false

# --- First admin account (created on first start if no admin exists) --------
ADMIN_EMAIL=admin@lexalyslabs.com
ADMIN_PASSWORD=change-me-123
ADMIN_NAME=Lexalys Admin

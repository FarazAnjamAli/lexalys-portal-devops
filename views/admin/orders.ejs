<%- include('../partials/top') %>
<%- include('../partials/admin-head', { heading: 'Orders', sub: 'Approve, start and deliver client orders.' }) %>
<div class="wrap app-body">
  <form class="filters" method="get" action="/admin/orders" id="order-filters">
    <div class="field"><label for="q">Search</label><input type="search" id="q" name="q" value="<%= q %>" placeholder="Order number, client or email"></div>
    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="">All statuses</option>
        <% statuses.forEach(function (s) { %><option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= fmt.status(s) %></option><% }) %>
      </select>
    </div>
    <button class="btn" type="submit" id="filter-submit">Filter</button>
    <% if (q || status) { %><a href="/admin/orders">Clear</a><% } %>
  </form>
  <p class="dim" id="result-count"><%= orders.length %> <%= orders.length === 1 ? 'order' : 'orders' %></p>
  <div class="table-wrap">
    <table class="data" id="admin-orders-table">
      <thead><tr><th>Order</th><th>Client</th><th>Service</th><th>Placed</th><th>Status</th><th class="num">Setup</th><th class="num">Monthly</th></tr></thead>
      <tbody>
        <% orders.forEach(function (o) { %>
          <tr data-order="<%= o.order_no %>">
            <td><a class="mono" href="/admin/orders/<%= o.id %>"><%= o.order_no %></a></td>
            <td><%= o.client_name %><div class="muted"><%= o.client_email %></div></td>
            <td><%= o.service_name %></td>
            <td><%= fmt.date(o.created_at) %></td>
            <td><span class="badge badge-<%= o.status %>"><%= fmt.status(o.status) %></span></td>
            <td class="num"><%= fmt.money(o.setup_total) %></td>
            <td class="num"><%= o.monthly_total ? fmt.money(o.monthly_total) : '-' %></td>
          </tr>
        <% }) %>
        <% if (!orders.length) { %><tr><td colspan="7" class="muted" id="no-results">No orders match these filters.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/bottom') %>

<%#
  Usage: include('partials/field', { name, label, type, value, error, hint, required, autocomplete, cls, attrs })
-%>
<% const _err = typeof error !== 'undefined' && error; const _type = (typeof type !== 'undefined' && type) || 'text'; -%>
<div class="field <%= _err ? 'has-error' : '' %> <%= typeof cls !== 'undefined' ? cls : '' %>">
  <label for="<%= name %>"><%= label %><% if (typeof required !== 'undefined' && required) { %> <span aria-hidden="true">*</span><% } %></label>
  <% if (_type === 'textarea') { %>
    <textarea id="<%= name %>" name="<%= name %>" <%= (typeof required !== 'undefined' && required) ? 'required' : '' %> <% if (_err) { %>aria-invalid="true" aria-describedby="<%= name %>-error"<% } %>><%= typeof value !== 'undefined' && value !== null ? value : '' %></textarea>
  <% } else { %>
    <input id="<%= name %>" name="<%= name %>" type="<%= _type %>" value="<%= typeof value !== 'undefined' && value !== null ? value : '' %>"
      <%= (typeof required !== 'undefined' && required) ? 'required' : '' %>
      <% if (typeof autocomplete !== 'undefined') { %>autocomplete="<%= autocomplete %>"<% } %>
      <% if (typeof attrs !== 'undefined') { %><%- attrs %><% } %>
      <% if (_err) { %>aria-invalid="true" aria-describedby="<%= name %>-error"<% } %>>
  <% } %>
  <% if (typeof hint !== 'undefined' && hint) { %><span class="hint"><%= hint %></span><% } %>
  <% if (_err) { %><span class="error" id="<%= name %>-error"><%= _err %></span><% } %>
</div>
